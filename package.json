{
  "name": "eduflex",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "prisma:validate": "node --env-file-if-exists=.env.local ./node_modules/prisma/build/index.js validate",
    "prisma:generate": "node --env-file-if-exists=.env.local ./node_modules/prisma/build/index.js generate",
    "prisma:format": "node --env-file-if-exists=.env.local ./node_modules/prisma/build/index.js format",
    "db:migrate:dev": "node --env-file-if-exists=.env.local ./node_modules/prisma/build/index.js migrate dev",
    "db:migrate:deploy": "node --env-file-if-exists=.env.local ./node_modules/prisma/build/index.js migrate deploy",
    "db:studio": "node --env-file-if-exists=.env.local ./node_modules/prisma/build/index.js studio"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "next": "^16.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "^6.16.2",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0"
  }
}
