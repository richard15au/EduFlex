# Public Application URL (Subdomain: eduflex.richv.win)
NEXT_PUBLIC_APP_URL="https://eduflex.richv.win"

# Neon Serverless PostgreSQL
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require"

# Cloudflare R2 (Primary Live Object Storage + Nightly DB & File DR Backups)
# Providing R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, and R2_SECRET_ACCESS_KEY enables both buckets automatically.
R2_ACCOUNT_ID=""
R2_ENDPOINT=""
R2_OBJECTS_BUCKET="eduflex-objects"
R2_BACKUP_BUCKET="eduflex-dr-backups"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""

# Vercel Cron Authorization Secret
CRON_SECRET=""
