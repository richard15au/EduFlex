# EduFlex LMS — Environment Variables Template
# Copy this file to `.env.local` or `.env` for local development.
# NEVER commit real database credentials, API keys, or secrets to version control.

# ── Neon Serverless PostgreSQL (Prisma) ────────────────────────────────────────
# Pooled connection string (via Neon PgBouncer `-pooler` endpoint) for runtime queries
DATABASE_URL="postgresql://DB_USER:DB_PASSWORD@ep-example-pooler.region.aws.neon.tech/eduflex?sslmode=require&pgbouncer=true&connect_timeout=15"

# Direct connection string (non-pooled endpoint) required for Prisma CLI migrations
DIRECT_URL="postgresql://DB_USER:DB_PASSWORD@ep-example.region.aws.neon.tech/eduflex?sslmode=require"

# ── Authentication & Session Security (Phase 3+) ───────────────────────────────
# Generate a 32+ byte random secret (e.g., `openssl rand -base64 32`)
AUTH_SECRET="replace-with-32-byte-minimum-random-secret-key"
SESSION_COOKIE_NAME="eduflex_session"
SESSION_TTL_MINUTES="60"

# ── Planned Institutional Domains (Informational / Non-Secret) ─────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_INSTITUTION_DOMAIN="richacademy.en-rich.me"
NEXT_PUBLIC_LMS_DOMAIN="eduflex.en-rich.me"
