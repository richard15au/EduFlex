// EduFlex LMS — Normalized PostgreSQL Schema (Phase 1 Foundation)
// Target Database: Neon Serverless PostgreSQL
// ORM: Prisma 6.x

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  PENDING
  REJECTED
}

enum ApprovalType {
  ACCOUNT_REGISTRATION
  LATE_ENROLLMENT
  COURSE_OVERRIDE
  ROLE_ELEVATION
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CourseStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

enum EnrollmentStatus {
  ENROLLED
  PENDING
  WAITLISTED
  DROPPED
  COMPLETED
}

enum AssignmentType {
  ASSIGNMENT
  ASSESSMENT
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
  ARCHIVED
}

enum SubmissionStatus {
  SUBMITTED
  RESUBMITTED
  GRADED
  RETURNED
}

enum QuizAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}

enum MaterialCategory {
  COURSE_MATERIAL
  ADDITIONAL_RESOURCE
  CLASS_RECORDING
  CODE_AND_LAB
}

enum MaterialFormat {
  PDF
  POWERPOINT
  DOCUMENT
  VIDEO
  ARCHIVE
  CODE_REPO
  EXTERNAL_LINK
}

enum AnnouncementAudience {
  ALL_USERS
  STUDENTS
  INSTRUCTORS
  COURSE_ONLY
}

enum CalendarCategory {
  ACADEMIC_DATE
  ENROLLMENT
  ASSESSMENT
  QUIZ
  LECTURE
  SCHOOL_BREAK
  PUBLIC_HOLIDAY
  EXAM
}

// ─── 1. Users, Roles, Account Status & Sessions ───────────────────────────────

model User {
  id           String        @id @default(cuid())
  /// Institutional or legacy identifier (e.g., "2003988", "STU-20262001", "INS-20260012")
  externalId   String?       @unique
  name         String
  /// Normalized lowercase email address. Authorization is NEVER inferred from email pattern/domain.
  email        String        @unique
  /// Argon2id or bcrypt password digest. Plaintext passwords MUST NEVER be stored.
  passwordHash String
  /// Authoritative server-side role controlling portal and API access.
  role         UserRole      @default(STUDENT)
  status       AccountStatus @default(PENDING)
  program      String? // e.g., "BS Information Technology" (Student)
  department   String? // e.g., "School of ICT" (Instructor / Admin)
  phone        String?
  avatarUrl    String?
  bio          String?
  timezone     String        @default("Australia/Sydney")
  lastActiveAt DateTime?
  joinedAt     DateTime      @default(now())
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Relations
  sessions                Session[]
  submittedApprovals      ApprovalRequest[]         @relation("ApprovalRequester")
  reviewedApprovals       ApprovalRequest[]         @relation("ApprovalReviewer")
  taughtCourses           Course[]                  @relation("CoursePrimaryInstructor")
  enrollments             Enrollment[]
  assignmentSubmissions   AssignmentSubmission[]    @relation("StudentAssignmentSubmissions")
  gradedSubmissions       AssignmentSubmission[]    @relation("InstructorGradedSubmissions")
  quizAttempts            QuizAttempt[]
  gradeRecords            GradeRecord[]             @relation("StudentGrades")
  awardedGrades           GradeRecord[]             @relation("InstructorAwardedGrades")
  uploadedMaterials       LearningMaterial[]
  authoredAnnouncements   Announcement[]
  announcementReads       AnnouncementRead[]
  conversationMemberships ConversationParticipant[]
  sentMessages            Message[]
  createdCalendarEvents   CalendarEvent[]

  @@index([role, status])
  @@index([status, createdAt])
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  /// SHA-256 hex digest of the opaque session token. Raw tokens MUST NEVER be stored in the database.
  tokenHash  String    @unique
  ipAddress  String?
  userAgent  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

// ─── 2. Approval Requests ─────────────────────────────────────────────────────

model ApprovalRequest {
  id            String         @id @default(cuid())
  referenceCode String?        @unique // e.g., "PA-001"
  requesterId   String
  type          ApprovalType   @default(ACCOUNT_REGISTRATION)
  /// Human-readable request summary (e.g., "Account Registration", "Late Enrollment – ICT301")
  actionLabel   String
  requestedRole UserRole       @default(STUDENT)
  courseId      String?
  status        ApprovalStatus @default(PENDING)
  notes         String?
  submittedAt   DateTime       @default(now())
  reviewedAt    DateTime?
  reviewedById  String?

  requester  User    @relation("ApprovalRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  reviewedBy User?   @relation("ApprovalReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  course     Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([status, submittedAt])
  @@index([requesterId])
  @@index([courseId])
}

// ─── 3. Courses & Enrollments ─────────────────────────────────────────────────

model Course {
  id           String       @id @default(cuid())
  /// Canonical unit code (e.g., "ICT301", "ICT272", "ICT126", "ICT350")
  code         String       @unique
  title        String
  faculty      String       @default("School of ICT")
  /// Academic term/semester label (e.g., "T2 2026", "T226")
  term         String
  academicYear Int          @default(2026)
  description  String?
  /// Optional structured weekly syllabus/module breakdown for CourseOverviewPage
  modulesJson  Json?
  iconColor    String       @default("#2563eb")
  bgColor      String       @default("#eff6ff")
  capacity     Int          @default(150)
  status       CourseStatus @default(ACTIVE)
  instructorId String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  instructor       User?              @relation("CoursePrimaryInstructor", fields: [instructorId], references: [id], onDelete: SetNull)
  enrollments      Enrollment[]
  assignments      Assignment[]
  quizzes          Quiz[]
  materials        LearningMaterial[]
  announcements    Announcement[]
  gradeRecords     GradeRecord[]
  calendarEvents   CalendarEvent[]
  approvalRequests ApprovalRequest[]
  conversations    Conversation[]

  @@index([status, term])
  @@index([instructorId])
}

model Enrollment {
  id            String           @id @default(cuid())
  referenceCode String?          @unique // e.g., "ENR-001"
  studentId     String
  courseId      String
  semester      String // e.g., "T2 2026"
  status        EnrollmentStatus @default(ENROLLED)
  /// Completion percentage (0..100) displayed on student course cards
  progressPct   Int              @default(0)
  finalScore    Float?
  finalGrade    String? // e.g., "HD", "D", "C", "P", "F"
  enrolledAt    DateTime         @default(now())
  completedAt   DateTime?
  droppedAt     DateTime?
  updatedAt     DateTime         @updatedAt

  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId, semester])
  @@index([courseId, status])
  @@index([studentId, status])
}

// ─── 4. Assignments & Submissions ─────────────────────────────────────────────

model Assignment {
  id                 String         @id @default(cuid())
  /// Stable slug matching frontend identifiers (e.g., "ict301-a1", "ict272-ass1")
  slug               String?        @unique
  courseId           String
  title              String
  description        String?
  /// Structured brief details: overview, numbered tasks, rubric criteria, and starter resource metadata
  instructionsJson   Json?
  type               AssignmentType @default(ASSIGNMENT)
  dueDate            DateTime
  maxScore           Float          @default(100)
  /// Coursework or assessment percentage weight (0..100)
  weightPct          Float          @default(10)
  acceptedFormats    String[]       @default([".ZIP", ".PDF"])
  maxFileSizeMb      Int            @default(50)
  namingConvention   String?
  allowResubmissions Boolean        @default(true)
  status             PublishStatus  @default(PUBLISHED)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  course       Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  submissions  AssignmentSubmission[]
  gradeRecords GradeRecord[]

  @@index([courseId, status, dueDate])
  @@index([dueDate])
}

model AssignmentSubmission {
  id                  String           @id @default(cuid())
  assignmentId        String
  studentId           String
  /// 1-based attempt counter supporting legitimate student resubmissions/revisions
  attemptNumber       Int              @default(1)
  /// Marks the active latest submission for a given (assignmentId, studentId)
  isLatest            Boolean          @default(true)
  /// Verification receipt code (e.g., "#EDF-2026-9418")
  receiptNumber       String           @unique
  /// File metadata only; binary payloads MUST be stored in object storage, never in PostgreSQL BYTEA
  fileName            String
  fileSizeLabel       String // e.g., "14.2 MB"
  fileSizeBytes       Int?
  mimeType            String?
  storageKey          String? // Object storage key/path
  storageUrl          String? // Signed or public download reference
  checksumSha256      String?
  comments            String?
  /// Must be explicitly accepted by the student; no permissive @default(true) is allowed.
  integrityAccepted   Boolean
  integrityAcceptedAt DateTime
  status              SubmissionStatus @default(SUBMITTED)
  score               Float?
  maxScore            Float            @default(100)
  gradeLabel          String? // e.g., "High Distinction (HD)"
  feedback            String?
  submittedAt         DateTime         @default(now())
  gradedAt            DateTime?
  gradedById          String?

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    User       @relation("StudentAssignmentSubmissions", fields: [studentId], references: [id], onDelete: Cascade)
  gradedBy   User?      @relation("InstructorGradedSubmissions", fields: [gradedById], references: [id], onDelete: SetNull)

  @@unique([assignmentId, studentId, attemptNumber])
  @@index([assignmentId, studentId, isLatest])
  @@index([studentId, submittedAt])
  @@index([status])
}

// ─── 5. Quizzes, Questions & Attempts ─────────────────────────────────────────

model Quiz {
  id              String        @id @default(cuid())
  /// Stable slug matching frontend identifiers (e.g., "q1", "q2", "q3")
  slug            String?       @unique
  courseId        String
  title           String
  description     String?
  dueDate         DateTime
  availableFrom   DateTime?
  timeLimitMins   Int           @default(30)
  attemptsAllowed Int           @default(1)
  weightPct       Float         @default(5)
  maxScore        Float         @default(15)
  status          PublishStatus @default(PUBLISHED)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  course       Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions    QuizQuestion[]
  attempts     QuizAttempt[]
  gradeRecords GradeRecord[]

  @@index([courseId, status, dueDate])
}

model QuizQuestion {
  id             String   @id @default(cuid())
  quizId         String
  questionNumber Int
  prompt         String
  codeSnippet    String?
  /// Ordered array of choice strings (e.g., ["option A", "option B", "option C", "option D"])
  optionsJson    Json
  /// SERVER-ONLY: 0-based index of the correct option. MUST NOT be serialized to students before attempt submission.
  correctIndex   Int
  /// SERVER-ONLY until attempt is completed: explanation shown in post-submission review.
  explanation    String?
  points         Float    @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  quiz           Quiz                @relation(fields: [quizId], references: [id], onDelete: Cascade)
  attemptAnswers QuizAttemptAnswer[]

  @@unique([quizId, questionNumber])
  @@index([quizId])
}

model QuizAttempt {
  id            String            @id @default(cuid())
  quizId        String
  studentId     String
  attemptNumber Int               @default(1)
  status        QuizAttemptStatus @default(IN_PROGRESS)
  score         Float?
  maxScore      Float
  percentage    Float?
  feedback      String?
  startedAt     DateTime          @default(now())
  submittedAt   DateTime?
  timeSpentSecs Int?

  quiz    Quiz                @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student User                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers QuizAttemptAnswer[]

  @@unique([quizId, studentId, attemptNumber])
  @@index([studentId, status])
  @@index([quizId, status])
}

model QuizAttemptAnswer {
  id            String   @id @default(cuid())
  attemptId     String
  questionId    String
  selectedIndex Int
  isCorrect     Boolean?
  pointsAwarded Float?

  attempt  QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([questionId])
}

// ─── 6. Grades ────────────────────────────────────────────────────────────────

model GradeRecord {
  id           String   @id @default(cuid())
  studentId    String
  courseId     String
  assignmentId String?
  quizId       String?
  awardedById  String?
  itemTitle    String
  /// Category label (e.g., "Assignment", "Assessment", "Quiz", "Final Exam")
  category     String
  score        Float
  maxScore     Float    @default(100)
  percentage   Float?
  weightPct    Float?
  /// Australian university grade band (e.g., "High Distinction (HD)", "Distinction (D)", "Credit (C)", "Pass (P)", "Fail (F)")
  gradeLabel   String?
  feedback     String?
  isReleased   Boolean  @default(true)
  releasedAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student    User        @relation("StudentGrades", fields: [studentId], references: [id], onDelete: Cascade)
  course     Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  assignment Assignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  quiz       Quiz?       @relation(fields: [quizId], references: [id], onDelete: SetNull)
  awardedBy  User?       @relation("InstructorAwardedGrades", fields: [awardedById], references: [id], onDelete: SetNull)

  @@unique([studentId, assignmentId])
  @@unique([studentId, quizId])
  @@index([studentId, courseId])
  @@index([courseId, isReleased])
  @@index([assignmentId])
  @@index([quizId])
}

// ─── 7. Learning Materials ────────────────────────────────────────────────────

model LearningMaterial {
  id            String           @id @default(cuid())
  courseId      String
  uploadedById  String?
  title         String
  description   String?
  category      MaterialCategory @default(COURSE_MATERIAL)
  format        MaterialFormat   @default(PDF)
  weekLabel     String? // e.g., "Week 1", "Week 4"
  /// File metadata or external resource link; binary content lives in object storage
  fileName      String?
  fileSizeLabel String? // e.g., "2.4 MB"
  fileSizeBytes Int?
  mimeType      String?
  storageKey    String?
  externalUrl   String? // For YouTube, GitHub repos, documentation links, or signed URLs
  sourceLabel   String? // e.g., "MDN Web Docs", "GitHub"
  durationLabel String? // e.g., "48 mins" for recorded lectures
  tags          String[]         @default([])
  isPublished   Boolean          @default(true)
  publishedAt   DateTime         @default(now())
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  course     Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  uploadedBy User?  @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([courseId, category, isPublished])
  @@index([uploadedById])
}

// ─── 8. Announcements ─────────────────────────────────────────────────────────

model Announcement {
  id          String               @id @default(cuid())
  code        String?              @unique // e.g., "ANN-001"
  /// Null for institution-wide announcements; populated for course-specific announcements
  courseId    String?
  authorId    String?
  authorName  String
  authorRole  String?
  title       String
  body        String
  audience    AnnouncementAudience @default(ALL_USERS)
  status      PublishStatus        @default(PUBLISHED)
  isImportant Boolean              @default(false)
  publishedAt DateTime             @default(now())
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  course Course?            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  author User?              @relation(fields: [authorId], references: [id], onDelete: SetNull)
  reads  AnnouncementRead[]

  @@index([status, audience, publishedAt])
  @@index([courseId, publishedAt])
}

model AnnouncementRead {
  id             String   @id @default(cuid())
  announcementId String
  userId         String
  readAt         DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([userId])
}

// ─── 9. Conversations & Messages ──────────────────────────────────────────────

model Conversation {
  id            String   @id @default(cuid())
  externalCode  String?  @unique // e.g., "conv-1" for idempotent seeding
  title         String?
  courseId      String?
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  course       Course?                   @relation(fields: [courseId], references: [id], onDelete: SetNull)
  participants ConversationParticipant[]
  messages     Message[]

  @@index([lastMessageAt])
  @@index([courseId])
}

model ConversationParticipant {
  id             String    @id @default(cuid())
  conversationId String
  userId         String
  unreadCount    Int       @default(0)
  lastReadAt     DateTime?
  joinedAt       DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId, unreadCount])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
}

// ─── 10. Calendar Events & System Settings ────────────────────────────────────

model CalendarEvent {
  id           String           @id @default(cuid())
  externalCode String?          @unique // e.g., "cal-1" for idempotent seeding
  courseId     String?
  createdById  String?
  title        String
  label        String?
  description  String?
  eventDate    DateTime
  timeLabel    String? // e.g., "10:00 AM - 12:00 PM AEST"
  location     String? // e.g., "Room 402 / Zoom"
  category     CalendarCategory @default(ACADEMIC_DATE)
  color        String           @default("#2563eb")
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  course    Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdBy User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([eventDate, category])
  @@index([courseId, eventDate])
}

model SystemSetting {
  id                      String    @id @default("default")
  institutionName         String    @default("EduFlex University")
  institutionEmail        String    @default("admin@richacademy.en-rich.me")
  contactNumber           String    @default("+61 2 9000 1234")
  timezone                String    @default("UTC+10:00 (Sydney / AEST)")
  academicYear            String    @default("2026")
  currentSemester         String    @default("Trimester 2, 2026")
  semesterStartDate       DateTime?
  semesterEndDate         DateTime?
  enrollmentPeriod        String    @default("Open")
  emailNotifications      Boolean   @default(true)
  studentNotifications    Boolean   @default(true)
  instructorNotifications Boolean   @default(true)
  systemAlerts            Boolean   @default(true)
  passwordPolicy          String    @default("Strong (Min 8 chars, mixed case, symbols)")
  sessionTimeoutMins      Int       @default(60)
  twoFactorAuth           Boolean   @default(false)
  loginSecurity           Boolean   @default(true)
  language                String    @default("English (US)")
  dateFormat              String    @default("MMM D, YYYY")
  theme                   String    @default("Light Mode")
  updatedAt               DateTime  @updatedAt
}
